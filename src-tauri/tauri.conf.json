{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeTrace",
  "version": "0.2.1",
  "identifier": "com.lifetrace.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run web:build",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LifeTrace",
        "width": 1460,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 680,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:3103; img-src 'self' asset: http://asset.localhost http://127.0.0.1:3444 data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/icons/icon-512.png"],
    "resources": {
      "../xunji_service/data/dictionary.db": "dictionary/dictionary.db"
    }
  }
}
