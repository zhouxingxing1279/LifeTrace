# Stock BeeCount clients connect directly to the server IP on the dedicated
# compatibility port. Caddy only performs plain HTTP routing; there is no TLS,
# certificate or domain requirement in this simple personal-server profile.
#
# BeeCount Base URL:
#   http://8.148.75.45:8869
# BeeCount API Prefix:
#   /api/v1

# Maximum attachment size accepted by the BeeCount compatibility API.
BEECOUNT_ATTACHMENT_MAX_UPLOAD_BYTES=67108864

# Legacy BeeCount Cloud is no longer part of the active deployment stack.
# Keep any historical BeeCount data export/volume backup outside the running
# Compose stack until migration/reconciliation is no longer needed.
