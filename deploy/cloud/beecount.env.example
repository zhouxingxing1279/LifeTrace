# Public host used by the prebuilt BeeCount iOS app.
BEECOUNT_DOMAIN=finance.8-148-75-45.sslip.io

# Optional image override. Pin a release tag or digest for controlled upgrades.
BEECOUNT_CLOUD_IMAGE=sunxiao0721/beecount-cloud:latest

# Optional first administrator. Leave both empty to let BeeCount Cloud create a
# random administrator on first boot and persist it inside /data.
BEECOUNT_ADMIN_EMAIL=
BEECOUNT_ADMIN_PASSWORD=

# Optional: enables BeeCount Cloud's embedded documentation Q&A only.
BEECOUNT_EMBEDDING_API_KEY=

# Phase 2: read-only LifeTrace -> BeeCount finance adapter. Use a BeeCount
# account without interactive 2FA; the adapter performs GET requests only.
BEECOUNT_ADAPTER_ENABLED=false
BEECOUNT_ADAPTER_BASE_URL=http://beecount-cloud:8080/
BEECOUNT_ADAPTER_EMAIL=
BEECOUNT_ADAPTER_PASSWORD=

# Exact LifeTrace cloud user ID allowed to use the shared upstream credential.
BEECOUNT_ADAPTER_LIFETRACE_USER_ID=
BEECOUNT_ADAPTER_TIMEOUT_SECONDS=10
BEECOUNT_ADAPTER_MAX_RESPONSE_BYTES=8388608
BEECOUNT_ATTACHMENT_MAX_UPLOAD_BYTES=67108864
