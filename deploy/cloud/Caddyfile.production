# Simple direct-IP production routing.
#
# This deployment intentionally uses plain HTTP to avoid DNS, ACME, SNI and
# certificate-management dependencies for this personal server.
http://:80 {
    encode zstd gzip

    redir /photo-challenge-upload /photo-challenge-upload/ 308

    handle_path /photo-challenge-upload/* {
        root * /srv-photo-challenge
        try_files {path} /index.html
        file_server
    }

    handle /api/* {
        reverse_proxy lifetrace-cloud:8787
    }

    handle /health/* {
        reverse_proxy lifetrace-cloud:8787
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# Stock BeeCount clients keep their original /api/v1 and /ws paths on a
# dedicated HTTP port so they cannot collide with native LifeTrace routes.
# Configure BeeCount with exactly: http://8.148.75.45:8869
http://:8869 {
    encode zstd gzip

    handle /ready {
        rewrite * /health/ready
        reverse_proxy lifetrace-cloud:8787
    }

    handle /api/v1/* {
        uri replace /api/v1/ /api/v1/integrations/beecount/compat/
        reverse_proxy lifetrace-cloud:8787
    }

    handle /ws {
        rewrite * /api/v1/integrations/beecount/compat/ws
        reverse_proxy lifetrace-cloud:8787
    }

    respond 404
}
