8-148-75-45.sslip.io {
    encode zstd gzip

    redir /photo-challenge-upload /photo-challenge-upload/ 308

    handle_path /photo-challenge-upload/* {
        root * /srv-photo-challenge
        try_files {path} /index.html
        file_server
    }

    handle /api/* {
        reverse_proxy lifetrace-cloud:8787
    }

    handle /health/* {
        reverse_proxy lifetrace-cloud:8787
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# Stock BeeCount clients keep using the original public protocol on a dedicated
# finance host. The Rust LifeTrace backend owns the data; Caddy only translates
# the public BeeCount paths into the internal compatibility namespace.
{$BEECOUNT_DOMAIN:finance.8-148-75-45.sslip.io} {
    encode zstd gzip

    # BeeCount Cloud exposes /ready directly. Preserve that probe contract while
    # delegating readiness to the unified LifeTrace backend.
    handle /ready {
        rewrite * /health/ready
        reverse_proxy lifetrace-cloud:8787
    }

    # Every stock BeeCount REST endpoint lives under /api/v1. The compatibility
    # routers use an internal prefix to avoid collisions with native LifeTrace
    # auth/sync APIs on the primary host.
    handle /api/v1/* {
        uri replace /api/v1/ /api/v1/integrations/beecount/compat/
        reverse_proxy lifetrace-cloud:8787
    }

    # Some BeeCount builds use /ws directly while newer builds use /api/v1/ws.
    # The latter is covered by the rule above; keep the legacy direct path too.
    handle /ws {
        rewrite * /api/v1/integrations/beecount/compat/ws
        reverse_proxy lifetrace-cloud:8787
    }

    respond 404
}
