# Production is exposed directly from the server IP. Keep HTTPS enabled because
# the LifeTrace production auth configuration requires secure cookies and an
# HTTPS PUBLIC_WEB_BASE_URL.
#
# Public IPv4 certificates from Let's Encrypt are short-lived. Force the ACME
# issuer to Let's Encrypt and use HTTP-01 only. IP-certificate support has had
# edge cases in TLS-ALPN validation, while HTTP-01 is sufficient here because
# production already exposes port 80 for certificate validation and redirects.
(ip_tls) {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
            disable_tlsalpn_challenge
        }
    }
}

https://8.148.75.45 {
    import ip_tls
    encode zstd gzip

    redir /photo-challenge-upload /photo-challenge-upload/ 308

    handle_path /photo-challenge-upload/* {
        root * /srv-photo-challenge
        try_files {path} /index.html
        file_server
    }

    handle /api/* {
        reverse_proxy lifetrace-cloud:8787
    }

    handle /health/* {
        reverse_proxy lifetrace-cloud:8787
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# Stock BeeCount clients use a dedicated port so their original /api/v1 and /ws
# paths cannot collide with native LifeTrace routes. The same public IP
# certificate is valid on this port; clients should configure exactly:
# https://8.148.75.45:8869
https://8.148.75.45:8869 {
    import ip_tls
    encode zstd gzip

    handle /ready {
        rewrite * /health/ready
        reverse_proxy lifetrace-cloud:8787
    }

    handle /api/v1/* {
        uri replace /api/v1/ /api/v1/integrations/beecount/compat/
        reverse_proxy lifetrace-cloud:8787
    }

    # Older BeeCount builds connect to /ws directly. Newer /api/v1/ws is
    # already covered by the /api/v1/* compatibility rewrite above.
    handle /ws {
        rewrite * /api/v1/integrations/beecount/compat/ws
        reverse_proxy lifetrace-cloud:8787
    }

    respond 404
}
