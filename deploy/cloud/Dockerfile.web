FROM node:22-alpine AS browser-builder

WORKDIR /workspace/apps/desktop

COPY apps/desktop/package.json apps/desktop/package-lock.json ./
RUN npm ci

COPY apps/desktop/ ./
RUN npm run browser:build

# Caddy 2.11 includes the public IP certificate support required by the
# production Caddyfile. Pin the known-good release instead of relying on the
# moving caddy:2 tag.
FROM caddy:2.11.4-alpine

COPY deploy/cloud/Caddyfile.production /etc/caddy/Caddyfile
COPY --from=browser-builder /workspace/apps/desktop/dist-browser /srv
COPY apps/photo-challenge-pwa /srv-photo-challenge

EXPOSE 80 443 8869
