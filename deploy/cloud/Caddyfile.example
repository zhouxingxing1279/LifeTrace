# EPIC-17 production TLS baseline.
#
# Set LIFETRACE_DOMAIN to the public hostname (for example life.example.com).
# Caddy obtains/renews the certificate automatically for a routable hostname.
# Only this TLS endpoint should be internet-facing; port 8787 remains private.

{$LIFETRACE_DOMAIN:localhost}:443 {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8787
}
